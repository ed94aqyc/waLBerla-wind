// ADAPTIVE refinement case, LARGE version for modern GPUs: adaptive.prm at 3 times the resolution in every direction
// (D = 45 cells on the finest level), with the same 8 x 3 x 3 root blocks and the same physical time. Blocks have
// 48 x 60 x 60 = 172,800 cells (27 times the small case). See also static_large.prm and uniform_large.prm.
//
// Minimal refinement benchmark on GPUs (one GPU per MPI process): one actuator line turbine (MEXICO rotor) in a
// fully periodic box with uniform initial flow, one refinement level.
// Cells: 13.7 M at the start (8 of 79 blocks on the finest level), growing with the wake.
// Memory: about 68 MB per block on the GPU (390 bytes per cell) and 29 MB per block of pinned host memory (CPU
// mirrors), i.e. 5.5 GB (measured) and 2.3 GB at the start, and at most the 39 GB and 17 GB of uniform_large.prm.
// The start of this case was run for 3 time steps on a GTX 980 Ti.

DomainSetup
{
    // in cells of the finest level. Root blocks have cellsPerBlock * 2^numLevels = 96 x 120 x 120 cells, i.e. the
    // 8 x 3 x 3 root blocks of the small case at 3 times the resolution.
    // On the GPU, a row of 48 + 4 ghost cells (52 floats) is padded to 64 floats (256 bytes, the pitch alignment of
    // waLBerla's GPU fields), i.e. 23 % more GPU memory. 60 cells in x would avoid that, but y and z would then have
    // to be 75 (odd) instead of 60.
    domainSize    < 768, 360, 360 >;
    cellsPerBlock < 48, 60, 60 >;   // cells per block on every level (even numbers)

    Refinement {
        // Finest level. The turbine region always stays on this level, and the depth of the forest is fixed.
        numLevels       1;
        BoundaryLayer   0;

        // Every 'refinementFrequency' time steps, blocks outside the turbine region are refined where the velocity
        // gradient measure (central velocity difference per cell, LU) exceeds 'upperLimit' and coarsened where it is
        // below 'lowerLimit'. Choose lowerLimit < upperLimit / 2. Set refinementFrequency to 0 to disable.
        Adaptive {
            // frequency x 3 (same physical time), limits / 3 (the velocity difference per cell scales with the
            // cell size)
            refinementFrequency 300;
            lowerLimit          1.6667e-4;
            upperLimit          6.6667e-4;
        }
    }
}

Parameters
{
    timesteps          6001;   // same physical time as the 2001 steps of the small case; one flow-through of the
                               // domain takes about 13300 time steps, the wake reaches x = 768 after at least
                               // 10800 time steps
    remainingTimeLoggerFrequency 10; // in seconds

    length_SI          4.5;
    length_LU          45;   // 3 x 15

    velocity_SI        10.05;
    velocity_LU        0.05773502691896259;

    viscosity_SI       1.82e-05;
    density_SI         1.197;

    driverType         None;   // only resets the force field

    gpuEnabledMPI      false;  // CUDA-aware MPI for the PDF communication
}

Initialisation {
    initialVelocity <0.05773502691896259, 0, 0>;
}

Boundaries
{
    setup                   Periodic;
    inflowType              Periodic;
    outflowType             Periodic;
    wallType                NoSlip;   // unused in the periodic setup

    inflowVelocity          <0.05773502691896259, 0, 0>;
    outflowPressure         1.0;
}

WindFarm{

    Turbine1
    {
        // turbine AABB [121.5, 166.5] x [157.5, 202.5] x [159.6, 204.6] inside the root block [96, 192] x [120, 240]^2
        basePoint             <144, 180, 180>;
        diameter_LU           45;
        hubRotationalVelocity <0,0,44.5163679>;
        towerDescription      Mexico.tower;
        bladeDescription      Mexico.blade;
        towerEffect     0;
        nacelleEffect   0;
        tipLoss         1;
        nPointsBlades   50;
        nPointsTower    2;
        nBlades         3;
        nacelleYaw      0;
        hubRadius_SI    0.21;
        hubDeport_SI    0.0;
        hubTilt         0.0;
        bladePitch      -2.3000244769936637;
        bladePrecone    0.0;
        aeroModel       actuatorLine;
    }
}

StabilityChecker
{
    checkFrequency 1200;   // every check copies all PDFs to the host (up to 13 GB in the uniform case)
    streamOutput   false;
    vtkOutput      false;
}

Output
{
    VTK {
        writeFrequency  0;        // velocity field and domain decomposition, e.g. 300 (up to about 8 GB per output)
        baseFolder      vtk_out;
    }
}
